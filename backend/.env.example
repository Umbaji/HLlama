DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/hllama_dev
SECRET_KEY=dev-secret-key-change-in-production-1234567890
# Required by POST /api/login. Generate 32 random bytes and store as 64 hex
# characters in the local secret store; never commit a real value.
ADMIN_LOGIN_BUCKET_KEY=
# MFA stays staged off until its independent 32-byte key is provisioned.
ADMIN_MFA_ENCRYPTION_KEY=
ADMIN_MFA_ENROLLMENT_ENABLED=false
ADMIN_MFA_REQUIRED=false
# Set to 1 only behind your reverse proxy or ingress.
LOGIN_TRUSTED_PROXY_HOPS=0
GOOGLE_API_KEY=your_google_api_key_here
BOT_API_KEY=your_bot_api_key_here
# Keep false until the deployed bot is confirmed to send X-Bot-Api-Key.
HEALTH_LOOKUP_AUTH_REQUIRED=false
HEALTH_NEAREST_RATE_LIMIT_PER_MINUTE=120
HEALTH_GEOCODE_RATE_LIMIT_PER_MINUTE=30
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
DEBUG=false
# Public interactive docs are restricted to explicit local development.
ENVIRONMENT=development
API_DOCS_ENABLED=true
# Shared secret between bot and backend for pseudonymous user IDs (HMAC).
# MUST be identical in the bot .env and kept secret in production.
# Required: the API refuses to start without it (e.g. `openssl rand -hex 32`).
PSEUDO_ID_SECRET=

# Consent form: JWT signing secret for consent links and the URL that serves /consent.
# Required: the API refuses to start without it.
CONSENT_TOKEN_SECRET=
CONSENT_PAGE_BASE_URL=http://localhost:8000
# WhatsApp number the consent page sends the woman back to.
CONSENT_WHATSAPP_NUMBER=00000000000

# Feedback question sent after a conversation: delay, and minimum days between two.
FEEDBACK_DELAY_MINUTES=30
FEEDBACK_COOLDOWN_DAYS=7

# Spec 002: retention period of the consent page (72 months from the last exchange).
# Keep RETENTION_DRY_RUN=true until the logged counts have been read in production.
RETENTION_MONTHS=72
RETENTION_SWEEP_INTERVAL_HOURS=24
RETENTION_BATCH=500
RETENTION_ENABLED=true
RETENTION_DRY_RUN=true

# Semantic recall of past exchanges (RAG). Off until the credentials are set;
# with EMBEDDING_ENABLED=false the search keeps using full-text unchanged.
EMBEDDING_ENABLED=false
# Base URL of the Azure OpenAI resource, without a path
# (https://<resource>.openai.azure.com). The embeddings client appends
# /openai/deployments/<model>/embeddings itself.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Cosine distance threshold; the closer to 0, the stricter the recall.
SEMANTIC_MAX_DISTANCE=0.65
# Background backfill cadence. The sweep fills the column in a few passes.
SEMANTIC_SWEEP_INTERVAL_SECONDS=60
SEMANTIC_SWEEP_BATCH=50
EMBEDDING_TIMEOUT_SECONDS=20

# The documentary base. The distance is tighter than the one over the exchanges:
# a passage that is not really about her question is worse than no passage.
KNOWLEDGE_MAX_DISTANCE=0.45
KNOWLEDGE_TOP_K=3

# --- Monitoring standard 1.0 ------------------------------------------------
# Key this service requires on GET /api/monitoring/*. Distinct from BOT_API_KEY
# and from any admin token: it grants that endpoint and nothing else, so a leak
# exposes health data and no personal data.
MONITORING_API_KEY=

MONITORING_SERVICE_KEY=hllama-api
MONITORING_SERVICE_NAME=HLlama API
MONITORING_RETENTION_DAYS=30

# WhatsApp Cloud API. Fallback channel of the monitoring standard, and a
# candidate channel where the platform writes to people directly.
WHATSAPP_ENABLED=true
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# SMS through OurVoice.
SMS_ENABLED=true
OURVOICE_API_URL=https://api.getourvoice.com/v1
OURVOICE_API_KEY=
OURVOICE_SMS_SENDER_ID=

# Reported by /monitoring/health. GIT_COMMIT is injected by the deploy.
APP_VERSION=2.0.0
GIT_COMMIT=
# Local API tester utility only.
API_BASE_URL=http://localhost:8000
GRADIO_PORT=7860
DEFAULT_REMINDER_TIMEZONE=Africa/Lome

# Identity this service reports under, and how long it keeps its history.
# Alerting. Numbers in E.164, comma separated; each is validated at startup
# and a rejected one is logged, because a silent typo means a silent incident.
MONITORING_ALERT_ENABLED=true
MONITORING_ALERT_PHONES=
MONITORING_ALERT_MIN_INTERVAL_MINUTES=15
MONITORING_ALERT_CONSECUTIVE_FAILURES=2

# WhatsApp used by the monitoring alerts only, separate from the product
# configuration above.
MONITORING_WHATSAPP_TOKEN=
MONITORING_WHATSAPP_PHONE_NUMBER_ID=
MONITORING_WHATSAPP_VERSION=v17.0
MONITORING_WHATSAPP_API_URL=https://graph.facebook.com
