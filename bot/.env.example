# WhatsApp API
ACCESS_TOKEN="YOUR_WHATSAPP_API_TOKEN"
APP_ID="YOUR_APP_ID"
APP_SECRET="YOUR_APP_SECRET"
RECIPIENT_WAID="+XXXXXXXXXX"
VERSION="v22.0"
PHONE_NUMBER_ID="YOUR_PHONE_NUMBER_ID"
VERIFY_TOKEN="YOUR_VERIFY_TOKEN"

# Azure OpenAI
AZURE_OPENAI_ENDPOINT="https://<your-resource>.services.ai.azure.com/openai/v1"
AZURE_OPENAI_API_KEY="YOUR_AZURE_OPENAI_API_KEY"
DEPLOYMENT_NAME="your-deployment-name"
# Bounds each Azure OpenAI call on the WhatsApp path.
OPENAI_TIMEOUT_SECONDS="20"
OPENAI_MAX_RETRIES="1"
DEFAULT_COUNTRY_CODE="TG"
DEFAULT_REMINDER_TIMEZONE="Africa/Lome"

# HLlama backend BASE URL (no /api suffix: the bot appends /api/bot/..., /api/nearest/...).
# HLLAMA_BACKEND_URL is still read as a legacy alias when this one is empty.
NEAREST_API_URL="https://<your-backend-host>"

# Backend auth (must match the backend BOT_API_KEY)
BOT_API_KEY="your_bot_api_key_here"

# Shared secret with the backend for pseudonymous user IDs (HMAC).
# MUST be identical to the backend PSEUDO_ID_SECRET and kept secret.
# The bot refuses to start while this example placeholder remains unchanged.
PSEUDO_ID_SECRET="change-me-pseudo-id-secret"

# French text-to-speech. Keep ELEVENLABS_API_KEY server-side only.
TTS_PROVIDER="elevenlabs"
ELEVENLABS_API_KEY="your_elevenlabs_api_key"
ELEVENLABS_VOICE_ID="your_elevenlabs_voice_id"
ELEVENLABS_MODEL_ID="eleven_flash_v2_5"
ELEVENLABS_OUTPUT_FORMAT="mp3_44100_128"
ELEVENLABS_CONNECT_TIMEOUT_SECONDS="1.5"
ELEVENLABS_READ_TIMEOUT_SECONDS="15"
ELEVENLABS_CIRCUIT_FAILURE_THRESHOLD="1"
ELEVENLABS_CIRCUIT_COOLDOWN_SECONDS="60"
ELEVENLABS_AUTH_COOLDOWN_SECONDS="300"
ELEVENLABS_BILLING_COOLDOWN_SECONDS="1800"
ELEVENLABS_MAX_AUDIO_BYTES="10485760"
ELEVENLABS_STABILITY="0.55"
ELEVENLABS_SIMILARITY_BOOST="0.80"
ELEVENLABS_STYLE="0"
ELEVENLABS_SPEAKER_BOOST="true"
ELEVENLABS_SPEED="0.95"

# Reminders (see docs/WHATSAPP_TEMPLATES.md)
REMINDER_SCHEDULER_ENABLED="true"
REMINDER_POLL_SECONDS="30"
REMINDER_DUE_LIMIT="20"
# Neutral first message on the lock screen, detail shown when she replies.
REMINDER_DISCREET="true"
# Approved templates, one per kind, used outside the 24h window. A kind left
# empty is reported failed with error "no_template" instead of being sent.
REMINDER_TEMPLATE_LANG="fr"
REMINDER_TEMPLATE_CYCLE="hllama_rappel_cycle"
REMINDER_TEMPLATE_PILL="hllama_rappel_pilule"
REMINDER_TEMPLATE_INJECTION="hllama_rappel_injection"
REMINDER_TEMPLATE_APPOINTMENT="hllama_rappel_rdv"
REMINDER_TEMPLATE_FEEDBACK="hllama_avis"
REMINDER_TEMPLATE_NOTICE="hllama_notification"
REMINDER_TEMPLATE_OTHER="hllama_rappel"
