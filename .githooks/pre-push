#!/bin/sh
# Second net: catches a commit made with --no-verify, before it leaves.
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" on stdin.
root=$(git rev-parse --show-toplevel)
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # New branch: compare against the closest commit the remote already has.
        base=$(git merge-base "$local_sha" origin/HEAD 2>/dev/null) || base="$local_sha^"
    else
        base="$remote_sha"
    fi
    python "$root/scripts/check_secrets.py" --range "$base..$local_sha" || status=1
done
exit $status
